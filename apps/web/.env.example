# Same Supabase project as the customer app (public anon key, safe in a browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend origin. Leave empty locally: Vite proxies /api to http://localhost:8000.
VITE_API_ORIGIN=
# Optional browser error reporting. Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
